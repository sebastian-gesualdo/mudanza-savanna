# Demo local aislada; poner false para usar servicios reales.
APP_DEMO=true
APP_ENV=development
APP_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Conexión PostgreSQL/Supabase (pooler en modo transaction, sin prepared statements).
DATABASE_URL=
# Las CA oficiales de Supabase están incluidas; false solo para PostgreSQL local.
DATABASE_SSL=true
AI_ENABLED=false
GENERATION_ENABLED=false
# Producción activa ambos modelos. Interruptores operativos para apagarlos:
AI_DISABLED=false
GENERATION_DISABLED=false
AI_GATEWAY_API_KEY=
DECISION_MODEL=typesafe-ai/jev
GENERATION_MODEL=deepseek/deepseek-v4-pro-0813
# Alternativa configurable de mayor capacidad: openai/gpt-6.1-sol
AI_BUDGET_USD=5
# Overrides opcionales. Tarifas oficiales verificadas en src/ai/config.ts; vacío usa ese registro.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_REQUEST_RESERVE_USD=
