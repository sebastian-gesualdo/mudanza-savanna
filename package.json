{
  "name": "casa-de-los-gesualdo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "tsx scripts/initial-production-setup.ts && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/domain.test.ts tests/chat.test.ts tests/offline.test.ts tests/database-tls.test.ts",
    "test:integration": "vitest run tests/database.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "members": "tsx scripts/members.ts",
    "backup:restore": "tsx scripts/restore.ts",
    "eval:ai": "tsx scripts/eval-ai.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.139",
    "idb": "8.0.3",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
